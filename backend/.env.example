# Copiá este archivo como .env y completá tus datos
PORT=3001

# Supabase > tu proyecto > botón "Connect" > "Transaction pooler" (puerto 6543).
# Reemplazá [YOUR-PASSWORD] por la contraseña de la base.
DATABASE_URL=

# Mostrar en consola las consultas SQL
DB_LOGGING=false

# URL del frontend que puede usar la API (CORS). Varias separadas por coma, o * para cualquiera.
# En Vercel: la URL de tu frontend, ej. https://think-eat.vercel.app
FRONTEND_URL=http://localhost:5173
